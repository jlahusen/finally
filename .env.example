# Required for AI chat. Without it the app still runs; the chat panel is disabled.
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: Massive (Polygon.io) API key for real market data. Empty = built-in simulator.
MASSIVE_API_KEY=

# Optional: "true" returns deterministic mock LLM responses (tests, no API key needed).
LLM_MOCK=false
